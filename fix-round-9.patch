index 0000000..0b98365
--- /dev/null
+++ b/tests/groups/easy-fw-chain.py
@@ -0,0 +1,238 @@
+"""easy (round 9): the firmware chain of board #6 (tools/pathA/pathA-flash.sh) plus the lk2nd composite boot.
+
+Happy path on the fake board: exact write order (GPT secondary, GPT primary, tz, rpm, sbl1, hyp, aboot, composite boot,
+userdata), --skipwrite dry pass before every firmware/boot write, full read-back, no reset and no `final`, composite
+layout (lk2nd 512 KiB + boot.img at 0x80000, never boot.img alone at offset 0), evidence recorded before the first write,
+read-only final check after userdata. Constant-sync tests against the shell scripts. Each check has a mutation proof."""
+import json, pathlib, re, shlex, sys
+root, tmp = sys.argv[1:3]
+sys.path.insert(0, str(pathlib.Path(root) / "tests"))
+sys.path.insert(0, root)
+import easy_support as E
+from tools.installer import easy, edl_runner
+
+R = pathlib.Path(root)
+SEC = E.SECTOR
+BOOT_LBA = 396384
+ORDER = [str(E.EMMC_SECTORS - 33), "0"] + [str(E.PATHA_REGIONS[n][0]) for n in E.PATHA_ORDER] + [str(BOOT_LBA), "2428000"]
+
+
+# ---------------------------------------------------------------- constants are the shell scripts' constants
+def sync_check(flash_sh, fwlib_sh, flash_board_sh, rollback_sh):
+    regions = {}
+    order = []
+    for match in re.finditer(r"(?m)^(tz|rpm|sbl1|hyp|aboot)\)\s+put (\w+) (\d+) (\d+)", flash_sh):
+        regions[match.group(2)] = (int(match.group(3)), int(match.group(4)))
+        order.append(match.group(2))
+    assert len(regions) == 5, "could not read the five firmware phases from pathA-flash.sh"
+    assert regions == easy.FW_REGIONS, "FW_REGIONS differ from pathA-flash.sh: %s vs %s" % (regions, easy.FW_REGIONS)
+    assert tuple(order) == easy.FW_PHASE_ORDER, "phase order differs from pathA-flash.sh: %s" % order
+    assert re.search(r"put gptS \$SEC_LBA 33 ", flash_sh) and re.search(r"put gptP 0 34 ", flash_sh)
+    assert flash_sh.index("put gptS") < flash_sh.index("put gptP"), "pathA-flash.sh writes the secondary GPT first"
+    assert (easy.GPT_SECONDARY_SECTORS, easy.GPT_PRIMARY_SECTORS) == (33, 34)
+    loader = re.search(r"LDR_SHA=\$\{FWLIB_TEST_LDR_SHA:-([0-9a-f]{64})\}", fwlib_sh)
+    assert loader and loader.group(1) == edl_runner.PINNED_LOADER_SHA256, "edl_runner PINNED_LOADER_SHA256 != fwlib.sh LDR_SHA"
+    assert loader.group(1).startswith("959439aa")
+    assert re.search(r"EMMC_SECTORS=(\d+)", fwlib_sh).group(1) == str(easy.FW_PKG_EMMC_SECTORS)
+    pin = re.search(r"LK2ND_PADDED_SHA256:-([0-9a-f]{64})\}", flash_board_sh)
+    assert pin and pin.group(1) == easy.LK2ND_PADDED_SHA256 and pin.group(1).startswith("d82f3535")
+    assert "LK_OFF=$((0x80000))" in flash_board_sh and easy.LK2ND_BOOT_OFFSET == 0x80000 and easy.LK2ND_SIZE == 524288
+    assert "LK1ST_BOOT=$((0x1000000))" in flash_board_sh and easy.BOOT_CAPACITY_SECTORS * SEC == 0x1000000
+    assert re.search(r"put boot 396384 32768 ", rollback_sh) and easy.BOOT_COMPOSITE_LBA == 396384
+    # easy.py keeps the same defaults as the scripts: no reset ported
+    assert "reset" not in " ".join(easy.ALLOWED_EDL_OPERATIONS) and "final" in easy.FORBIDDEN_PHASES
+
+
+texts = [(R / "tools" / name).read_text() for name in ("pathA/pathA-flash.sh", "pathA/fwlib.sh", "flash/flash-board.sh", "pathA/pathA-rollback.sh")]
+sync_check(*texts)
+E.must_fail(sync_check, texts[0].replace("put aboot 264192 2048", "put aboot 264192 1024"), *texts[1:])
+E.must_fail(sync_check, texts[0].replace("tz)    put tz", "tx)    put tz"), *texts[1:])
+E.must_fail(sync_check, texts[0], texts[1].replace("959439aa", "959439ab"), *texts[2:])
+E.must_fail(sync_check, texts[0], texts[1], texts[2].replace("d82f3535", "d82f3536"), texts[3])
+E.must_fail(sync_check, texts[0], texts[1], texts[2].replace("0x80000", "0x40000"), texts[3])
+E.must_fail(sync_check, texts[0], texts[1], texts[2], texts[3].replace("396384", "396385"))
+
+# ---------------------------------------------------------------- happy path
+board = E.Board(root, tmp, "fwchain")
+image_set = board.make_image_set()
+board.fw_pkg = board.make_fw_pkg()
+BYTES = board.base / "edl-bytes.log"
+BYTES.write_text("")
+rc, out = E.happy(board, [E.FLAG_IMAGE_SET, str(image_set), E.FLAG_YES], E.base_rules(board, yes=True),
+                  env_overrides={"OPENSTICK_EDL_BYTES_FILE": str(BYTES)})
+assert rc == 0, "reference run failed:\n" + out[-2500:]
+E.check_no_traceback(out)
+overlays = E.expected_overlays(image_set)
+E.check_layout(board.disk, board.initial, overlays)
+
+commands = [shlex.split(line) for line in board.cmd_log.read_text().splitlines() if line.strip()]
+boot_composite = E.synthetic_lk2nd() + (image_set / "payload/boot.img").read_bytes()
+
+
+def check_order(targets):
+    assert targets == ORDER, "write order is not gpt secondary, gpt primary, tz, rpm, sbl1, hyp, aboot, boot, userdata: %s" % targets
+
+
+def check_dry_then_write(cmds):
+    """Mirror of put() in fwlib.sh: every non-userdata write is preceded by a --skipwrite pass of the SAME file, and every ws
+    has --sectorsize=512; --lun never appears."""
+    ws = [c for c in cmds if c[0] == "ws"]
+    assert ws, "no ws command ran"
+    for index, c in enumerate(ws):
+        assert "--sectorsize=512" in c, "ws without --sectorsize=512: %s" % c
+        assert not any(a.startswith("--lun") for a in c), "--lun used: %s" % c
+    seen_dry = set()
+    for c in ws:
+        key = (c[1], c[2])
+        if "--skipwrite" in c:
+            seen_dry.add(key)
+        elif c[1] != "2428000":                      # userdata keeps the sampled path of _write_and_check
+            assert key in seen_dry, "write to LBA %s without a --skipwrite pass first" % c[1]
+            seen_dry.discard(key)
+    assert sum(1 for c in ws if "--skipwrite" in c) == 8, "expected 8 dry passes (2 GPT, 5 firmware, composite boot)"
+
+
+def check_no_reset(cmds, text):
+    for c in cmds:
+        assert c[0] in ("rs", "ws", "rf"), "unexpected edl operation: %s" % c
+        assert not any("reset" in a.lower() for a in c), "an edl argument contains reset: %s" % c
+    assert "No reset was sent" in text
+
+
+E.check_order(E.write_targets(board))
+check_order(E.write_targets(board))
+check_dry_then_write(commands)
+check_no_reset(commands, out)
+
+# full read-back (whole region) after each firmware/GPT/boot write; sampling for userdata only
+reads = [tuple(line.split()[1:3]) for line in BYTES.read_text().splitlines() if line.startswith("rs ")]
+for name in E.PATHA_ORDER:
+    lba, sectors = E.PATHA_REGIONS[name]
+    assert (str(lba), str(sectors)) in reads, "no full read of %s" % name
+assert (str(BOOT_LBA), str(len(boot_composite) // SEC)) in reads, "no full read-back of the composite boot"
+assert any(lba == "2428000" for lba, _n in reads), "userdata is not read back"
+assert not any(lba == "2428000" and int(n) > 4096 for lba, n in reads), "userdata read-back is more than its two samples"
+
+# composite layout: lk2nd first, boot.img at 0x80000, never boot.img alone at offset 0
+def check_composite(disk):
+    with open(disk, "rb") as f:
+        f.seek(BOOT_LBA * SEC)
+        head = f.read(len(boot_composite))
+    assert head[:0x80000] == E.synthetic_lk2nd(), "lk2nd is not at the start of the boot partition"
+    assert head[0x80000:] == (image_set / "payload/boot.img").read_bytes(), "boot.img is not at 0x80000"
+    assert head[:8] != b"ANDROID!" or head[:0x80000] == E.synthetic_lk2nd(), "boot.img was written alone at offset 0"
+check_composite(board.disk)
+boot_write = [c for c in commands if c[0] == "ws" and c[1] == str(BOOT_LBA) and "--skipwrite" not in c][0]
+assert pathlib.Path(boot_write[2]).name == "boot-composite.img"
+
+# final check: after userdata and the preserved step, read only, before the cold-boot message
+i_user, i_final, i_cold = out.index("userdata written"), out.index("ALL REGIONS == NEW IMAGES"), out.index("Cold boot is the only supported reboot")
+assert i_user < i_final < i_cold, "final check is not between the userdata write and the cold boot message"
+last_ws = max(i for i, c in enumerate(commands) if c[0] == "ws")
+assert any(c[0] == "rs" and c[1] == str(E.PATHA_REGIONS["aboot"][0]) for c in commands[last_ws + 1:]), "firmware is not read back after the last write"
+assert any(c[0] == "rs" and c[1] == "0" for c in commands[last_ws + 1:]) and any(c[0] == "rs" and c[1] == str(E.EMMC_SECTORS - 33) for c in commands[last_ws + 1:]), "GPTs are not read back after the last write"
+assert re.search(r"unplug USB, wait 30 s, plug in WITHOUT the button, then ssh", out)
+E.check_order(E.write_targets(board))
+
+# evidence and registry: hashes and phase order, recorded for the guided restore; no blobs in the registry
+entry = E.flash_entries(board)[-1]
+fw = entry["firmware"]
+assert fw["phase_order"] == ["gpt", "tz", "rpm", "sbl1", "hyp", "aboot", "boot", "userdata", "preserved partitions", "final check"], fw["phase_order"]
+assert fw["composite_sha256"] == E.sha256_hex(boot_composite) and fw["composite_bytes"] == len(boot_composite)
+for name in E.PATHA_ORDER:
+    assert fw["new_sha256"][name] == E.sha256_hex(E.fw_image(name)), name
+def initial(lba, n):
+    with board.initial.open("rb") as disk:
+        disk.seek(lba * SEC); return disk.read(n * SEC)
+assert fw["stock_sha256"]["tz"] == E.sha256_hex(initial(270336, 2048)), "stock tz hash must be tz + tzbak from the BACKUP"
+assert fw["stock_sha256"]["aboot"] == E.sha256_hex(initial(264192, 2048))
+registry_text = (board.home / "registry.json").read_text() if (board.home / "registry.json").exists() else json.dumps(E.registry(board))
+assert len(registry_text) < 200000 and E.fw_image("tz")[:64].hex() not in registry_text, "blob content leaked into the registry"
+evidence = pathlib.Path(entry["image_set"])
+assert (evidence / "pathA/fw/tz.img").read_bytes() == E.fw_image("tz")
+assert (evidence / "pathA/rollback/stock-tz-tzbak.bin").read_bytes() == initial(270336, 2048)
+
+# ---------------------------------------------------------------- source-level: the SIGINT shield covers every phase
+import inspect
+def shield_covers_all(src):
+    body = src[src.index("with _SigintShield():"):]
+    assert "_write_phases(ctx, temp, plan)" in body.split("\n")[1], "_write_phases is not inside the SIGINT shield"
+    wp = inspect.getsource(easy._write_phases)
+    for needle in ('"gpt"', "FW_PHASE_ORDER", '"boot"', '"userdata"', '"final check"'):
+        assert needle in wp
+    assert "_SigintShield" not in wp, "phases must not open their own shield"
+shield_covers_all(inspect.getsource(easy.step8_flash))
+E.must_fail(shield_covers_all, inspect.getsource(easy.step8_flash).replace("with _SigintShield():\n            _write_phases", "with _SigintShield():\n            pass\n        if True:\n            _write_phases"))
+
+# ---------------------------------------------------------------- no reset / no final, ever
+class _Ctx:
+    session = type("S", (), {"run": staticmethod(lambda *a, **k: (_ for _ in ()).throw(AssertionError("edl was called")))})()
+    phase = "x"; home = pathlib.Path(tmp); device_id = "d"; args = type("A", (), {})()
+def must_refuse_reset():
+    try:
+        easy._edl(_Ctx, ["reset", "--resetmode=reset"], 5)
+    except easy.EasyError as exc:
+        assert "never a reset" in str(exc)
+        return
+    raise AssertionError("an edl reset was not refused")
+must_refuse_reset()
+try:
+    easy._edl(_Ctx, ["ws", "0", "x", "--resetmode=reset"], 5)
+    raise SystemExit("an argument containing reset was accepted")
+except easy.EasyError:
+    pass
+def phase_final_refused():
+    try:
+        easy._phase(_Ctx, "final")
+    except easy.EasyError:
+        return
+    raise AssertionError("phase final was accepted")
+phase_final_refused()
+real_guard, real_forbidden = easy._check_edl_args, easy.FORBIDDEN_PHASES
+easy._check_edl_args = lambda args: None                # mutation: the argument guard is gone
+E.must_fail(must_refuse_reset)
+easy._check_edl_args = real_guard
+easy.FORBIDDEN_PHASES = ()
+E.must_fail(phase_final_refused)
+easy.FORBIDDEN_PHASES = real_forbidden
+
+# ---------------------------------------------------------------- mutation proofs on the happy-path oracles
+E.must_fail(check_order, list(reversed(E.write_targets(board))))
+E.must_fail(check_order, [ORDER[0]] + ORDER[2:3] + ORDER[1:2] + ORDER[3:])        # wrong GPT order
+swapped = ORDER[:2] + [ORDER[3], ORDER[2]] + ORDER[4:]
+E.must_fail(check_order, swapped)                                                  # rpm before tz
+E.must_fail(check_dry_then_write, [c for c in commands if "--skipwrite" not in c])  # no dry pass at all
+E.must_fail(check_dry_then_write, commands + [["ws", "270336", "x", "--sectorsize=512"]])      # a write without its own dry pass
+E.must_fail(check_dry_then_write, [c + ["--lun=0"] if c[0] == "ws" else c for c in commands])
+E.must_fail(check_dry_then_write, [[a for a in c if a != "--sectorsize=512"] for c in commands])
+E.must_fail(check_no_reset, commands + [["reset", "--resetmode=reset"]], out)
+E.must_fail(check_no_reset, commands, out.replace("No reset was sent", "x"))
+E.must_fail(check_no_reset, commands + [["ws", "0", "f", "--resetmode=reset"]], out)
+import shutil
+broken = board.base / "alone.img"
+shutil.copy(board.disk, broken)
+with broken.open("r+b") as f:                       # lk2nd replaced by boot.img at offset 0 (the forbidden layout)
+    f.seek(BOOT_LBA * SEC); f.write((image_set / "payload/boot.img").read_bytes())
+E.must_fail(check_composite, broken)
+E.must_fail(E.check_layout, broken, board.initial, overlays)
+E.must_fail(E.check_layout, board.disk, board.initial, [o for o in overlays if o[0] != 270336 * SEC])   # tz write missing from the oracle
+def final_after_user(text):
+    for needle in ("userdata written", "ALL REGIONS == NEW IMAGES", "Cold boot is the only"):
+        assert needle in text, needle + " missing"
+    assert text.index("userdata written") < text.index("ALL REGIONS == NEW IMAGES") < text.index("Cold boot is the only")
+final_after_user(out)
+E.must_fail(final_after_user, "ALL REGIONS == NEW IMAGES\n" + out.replace("ALL REGIONS == NEW IMAGES", "x"))   # final check before userdata
+E.must_fail(final_after_user, out.replace("ALL REGIONS == NEW IMAGES", "x"))                                      # no final check
+E.must_fail(final_after_user, out.replace("Cold boot is the only", "x"))                                          # no cold boot message
+
+# ---------------------------------------------------------------- product mutations
+def run_mut(name, mutation):
+    board.reset_disk()
+    return E.happy(board, [E.FLAG_IMAGE_SET, str(image_set), E.FLAG_YES], E.base_rules(board, yes=True),
+                   env_overrides={"OPENSTICK_TEST_MUTATE": mutation})
+rc_o, out_o = run_mut("order", "wrong-phase-order")
+assert board.writes(), "wrong-order mutation wrote nothing: it proves nothing"
+E.must_fail(check_order, E.write_targets(board))
+rc_b, out_b = run_mut("alone", "boot-alone")
+assert board.writes(), "boot-alone mutation wrote nothing: it proves nothing"
+E.must_fail(check_composite, board.disk)
diff --git a/tests/groups/easy-fw-failure.py b/tests/groups/easy-fw-failure.py
new file mode 100644
index 0000000..8da25bf
--- /dev/null
+++ b/tests/groups/easy-fw-failure.py
@@ -0,0 +1,87 @@
+"""easy (round 9): failures inside the firmware chain.
+
+* the registry/evidence of the chain (hashes, phase order, composite) exists BEFORE the first write (failure at write 1);
+* a read-back mismatch in the middle of the chain (rpm) stops at once: no later phase is written, flash entry says
+  partial-failure, a restore command is printed;
+* a failure between phases (after tz, after rpm+sbl1, at boot) leaves a state the printed guided `restore` handles
+  (or, where the guarded restore is fail-closed by design, refuses and writes nothing: pinned as a known limit).
+Mutation proofs: read-back compare off, checker mutations."""
+import pathlib, re, sys
+root, tmp = sys.argv[1:3]
+sys.path.insert(0, str(pathlib.Path(root) / "tests"))
+import easy_support as E
+
+LBA = {n: str(v[0]) for n, v in E.PATHA_REGIONS.items()}
+SEC_GPT = str(E.EMMC_SECTORS - 33)
+WRITE_ORDER = [SEC_GPT, "0", LBA["tz"], LBA["rpm"], LBA["sbl1"], LBA["hyp"], LBA["aboot"], "396384", "2428000"]
+
+
+def failing_run(name, env, image_set=None):
+    board = E.Board(root, tmp, name)
+    image_set = image_set or board.make_image_set()
+    env = dict(env, OPENSTICK_EDL_WRITE_COUNT_FILE=str(board.base / "wc"))
+    rc, out = E.happy(board, [E.FLAG_IMAGE_SET, str(image_set), E.FLAG_YES], E.base_rules(board, yes=True), env_overrides=env)
+    return board, rc, out
+
+
+def check_stopped(board, rc, out, n, pattern):
+    assert rc != 0, "the injected failure exited 0"
+    E.check_no_traceback(out)
+    E.check_restore_hint(out)
+    assert re.search(pattern, out), "reason %r not printed:\n%s" % (pattern, out[-900:])
+    assert E.write_targets(board) == WRITE_ORDER[:n], "writes after the failure point: %s" % E.write_targets(board)
+    entries = E.flash_entries(board)
+    assert len(entries) == 1 and entries[0]["outcome"] == "partial-failure-reconciliation-required", entries
+    assert entries[0]["phases"][-1]["result"] == "failed" and entries[0]["phases"][-1]["verified"] is False
+
+
+# 1. A failure at the very first write: the chain's hashes and phase order are already registered, evidence exists.
+board1, rc1, out1 = failing_run("fwfail-first", {"OPENSTICK_EDL_FAIL_WRITE_AT": "1"})
+check_stopped(board1, rc1, out1, 1, r"EDL client exited")
+entry = E.flash_entries(board1)[0]
+assert entry["firmware"]["phase_order"][:6] == ["gpt", "tz", "rpm", "sbl1", "hyp", "aboot"]
+assert entry["firmware"]["composite_sha256"] and set(entry["firmware"]["new_sha256"]) == {"gptP", "gptS", "sbl1", "rpm", "tz", "hyp", "aboot"}
+evidence = pathlib.Path(entry["image_set"])
+for name in E.PATHA_ORDER:
+    assert (evidence / "pathA/fw" / (name + ".img")).read_bytes() == E.fw_image(name), name
+assert (evidence / "pathA/SHA256SUMS").is_file() and (evidence / "SHA256SUMS").is_file()
+events = [e for e in E.events(board1) if e.get("outcome") == "registered"]
+assert events and events[0]["firmware"]["phase_order"] == entry["firmware"]["phase_order"], "no registered event with the plan"
+assert board1.unchanged(), "the first write failed but the disk changed"
+
+# 2. Read-back mismatch at rpm (the 4th write): nothing after rpm is written.
+RB = {"OPENSTICK_EDL_CORRUPT_RS_LBA": LBA["rpm"], "OPENSTICK_EDL_CORRUPT_RS_AFTER_WRITES": "4"}
+board2, rc2, out2 = failing_run("fwfail-readback", RB)
+check_stopped(board2, rc2, out2, 4, r"READ-BACK MISMATCH in rpm")
+assert not board2.unchanged()
+
+# 2b. Mutation: read-back compare off. The chain no longer stops at rpm, so the oracle must fail.
+board2m, rc2m, out2m = failing_run("fwfail-readback-mut", dict(RB, OPENSTICK_TEST_MUTATE="no-readback-compare"))
+E.must_fail(check_stopped, board2m, rc2m, out2m, 4, r"READ-BACK MISMATCH in rpm")
+assert len(E.write_targets(board2m)) > 4, "mutation run: the chain did not continue past rpm, so it proves nothing"
+
+# 3. Interrupted between phases, then the printed guided restore.
+results = {}
+for label, n in (("tz-failed", 3), ("after-rpm-sbl1", 6), ("boot-failed", 8)):
+    board, rc, out = failing_run("fwfail-" + label, {"OPENSTICK_EDL_FAIL_WRITE_AT": str(n)})
+    check_stopped(board, rc, out, n, r"EDL client exited")
+    command = E.printed_restore_command(out)
+    rc_r, out_r = E.run_printed_restore(board, command)
+    results[label] = (board, rc_r, out_r)
+    if rc_r == 0:
+        E.check_restored(board, rc_r, out_r)
+    else:                                                   # fail-closed by design: refuses, writes nothing more
+        assert board.writes()[:n] and len(board.writes()) == n, "a refused restore wrote to the board"
+        print("KNOWN LIMIT: restore after a failure at write %d refused: %s" % (n, out_r.strip().splitlines()[-1][:160]))
+
+# At least the states with a real new firmware region must be restorable; the first-phase tz failure is the fail-closed case.
+for label in ("after-rpm-sbl1", "boot-failed"):
+    board, rc_r, out_r = results[label]
+    E.check_restored(board, rc_r, out_r)
+board_f, rc_f, out_f = results["after-rpm-sbl1"]
+E.must_fail(E.check_restored, board_f, rc_f, out_f.replace("PASS final", "x"))
+E.must_fail(E.check_restored, results["tz-failed"][0], 1, "refused")                       # a refused restore is not "restored"
+E.must_fail(check_stopped, board2, 0, out2, 4, r"READ-BACK")                              # exit 0 instead of a stop
+E.must_fail(check_stopped, board2, rc2, out2, 5, r"READ-BACK")                            # wrong stopping point
+E.must_fail(check_stopped, board2, rc2, out2.replace("MISMATCH", "ok"), 4, r"READ-BACK MISMATCH")
+E.must_fail(check_stopped, board2, rc2, re.sub(r"(?i)restore", "xx", out2), 4, r"READ-BACK")
diff --git a/tests/groups/easy-fw-guards.py b/tests/groups/easy-fw-guards.py
new file mode 100644
index 0000000..6f6c53e
--- /dev/null
+++ b/tests/groups/easy-fw-guards.py
@@ -0,0 +1,306 @@
+"""easy (round 9): everything that must stop BEFORE the first write of the firmware chain.
+
+Unit level (direct calls, fast): firmware package verification (missing/altered file, wrong size, bad SHA256SUMS, symlink,
+inside the repo), manifest vs board/backup, the tz..tzbak range check with WRITTEN_NAMES extended, lk2nd composite (pin, size,
+fit). End to end on the fake board: no package, altered package, pkg GPT-T not byte-identical to the derived one, wrong
+EMMC_SECTORS, package in the repo or behind a symlink, region UNKNOWN or already NEW, backup firmware at the wrong LBA,
+composite too large. Every check has a mutation proof."""
+import os, pathlib, shutil, sys
+root, tmp = sys.argv[1:3]
+sys.path.insert(0, str(pathlib.Path(root) / "tests"))
+sys.path.insert(0, root)
+import easy_support as E
+from tools.installer import easy
+
+SEC = E.SECTOR
+board = E.Board(root, tmp, "fwguards")
+UNIT = pathlib.Path(tmp) / "fwguards-unit"
+UNIT.mkdir()
+
+
+def fresh(name, edit=None, sums=True):
+    return board.make_fw_pkg(name, edit=edit, sums=sums)
+
+
+def refused(pkg, pattern):
+    """Unit check: easy._load_fw_pkg(repo, pkg) must raise EasyError matching `pattern`."""
+    import re
+    try:
+        easy._load_fw_pkg(root, pkg)
+    except easy.EasyError as exc:
+        assert re.search(pattern, str(exc)), "wrong reason: %s" % exc
+        assert "Nothing was written" in str(exc)
+        return
+    raise AssertionError("the package was accepted (expected %r)" % pattern)
+
+
+good = fresh("pkg-good")
+loaded = easy._load_fw_pkg(root, good)
+assert set(loaded["fw"]) == set(easy.FW_PHASE_ORDER) and loaded["manifest"]["BOARD"] == "ufi103s"
+
+
+def flip(path):
+    data = bytearray(path.read_bytes()); data[100] ^= 1; path.write_bytes(bytes(data))
+
+
+cases = {}
+cases["missing"] = (fresh("pkg-missing", lambda d: (d / "fw/rpm.img").unlink(), sums=False), r"fw/rpm\.img is missing")
+cases["altered"] = (fresh("pkg-altered", lambda d: flip(d / "fw/aboot.img"), sums=False), r"fw/aboot\.img does not match SHA256SUMS")
+cases["short"] = (fresh("pkg-short", lambda d: (d / "fw/tz.img").write_bytes((d / "fw/tz.img").read_bytes()[:-512])), r"fw/tz\.img is 1048064 bytes, the region needs exactly 1048576")
+def junk_sums(d):
+    (d / "SHA256SUMS").write_text((d / "SHA256SUMS").read_text() + "this is not a sums line\n")
+cases["junk"] = (fresh("pkg-junk", junk_sums, sums=False), r"malformed SHA256SUMS")
+def drop_tz(d):
+    (d / "SHA256SUMS").write_text("".join(l + "\n" for l in (d / "SHA256SUMS").read_text().splitlines() if "fw/tz.img" not in l))
+cases["unlisted"] = (fresh("pkg-unlisted", drop_tz, sums=False), r"does not list fw/tz\.img")
+def traversal(d):
+    (d / "SHA256SUMS").write_text((d / "SHA256SUMS").read_text() + "%s  ../escape\n" % ("0" * 64))
+cases["traversal"] = (fresh("pkg-trav", traversal, sums=False), r"unsafe path")
+def wrong_digest(d):
+    lines = (d / "SHA256SUMS").read_text().splitlines()
+    lines = [("0" * 64 + l[64:]) if "fw/sbl1.img" in l else l for l in lines]
+    (d / "SHA256SUMS").write_text("\n".join(lines) + "\n")
+cases["digest"] = (fresh("pkg-digest", wrong_digest, sums=False), r"fw/sbl1\.img does not match SHA256SUMS")
+def nosums(d):
+    (d / "SHA256SUMS").unlink()
+cases["nosums"] = (fresh("pkg-nosums", nosums, sums=False), r"SHA256SUMS is missing")
+def link_member(d):
+    data = (d / "fw/hyp.img").read_bytes(); (d / "fw/hyp.real").write_bytes(data); (d / "fw/hyp.img").unlink(); (d / "fw/hyp.img").symlink_to("hyp.real")
+cases["member-symlink"] = (fresh("pkg-msym", link_member, sums=False), r"fw/hyp\.img is missing or is a symlink")
+link = board.base / "pkg-link"
+link.symlink_to(good)
+cases["dir-symlink"] = (link, r"must not be a symlink")
+inrepo = pathlib.Path(root) / (".fwpkg-test-%d" % os.getpid())
+try:
+    shutil.copytree(good, inrepo)
+    cases["in-repo"] = (inrepo, r"OUTSIDE the repo")
+    for name, (pkg, pattern) in cases.items():
+        refused(pkg, pattern)
+    # ---- mutation proofs (unit): the one check that stops each case, removed, lets it through
+    real_sha, real_parse, real_dir, real_regions, real_files = easy._sha_file, easy._parse_sums, easy._check_pkg_dir, dict(easy.FW_REGIONS), easy.FW_PKG_FILES
+    listed = {}
+    for l in (cases["altered"][0] / "SHA256SUMS").read_text().splitlines():
+        listed[l[66:]] = l[:64]
+    easy._sha_file = lambda path, offset=0, length=None: listed.get(pathlib.Path(path).relative_to(cases["altered"][0]).as_posix(), "x") if str(path).startswith(str(cases["altered"][0])) else real_sha(path, offset, length)
+    E.must_fail(refused, *cases["altered"]); easy._sha_file = real_sha
+    easy.FW_REGIONS["tz"] = (270336, 2047)
+    E.must_fail(refused, *cases["short"]); easy.FW_REGIONS.update(real_regions)
+    easy._parse_sums = lambda text: {l.split("  ", 1)[1]: l.split("  ", 1)[0] for l in text.splitlines() if "  " in l}
+    E.must_fail(refused, *cases["junk"]); E.must_fail(refused, *cases["traversal"]); easy._parse_sums = real_parse
+    easy._check_pkg_dir = lambda repo, path: pathlib.Path(path).resolve()
+    E.must_fail(refused, *cases["dir-symlink"]); E.must_fail(refused, *cases["in-repo"]); easy._check_pkg_dir = real_dir
+    easy.FW_PKG_FILES = ()
+    E.must_fail(refused, *cases["unlisted"]); easy.FW_PKG_FILES = real_files
+    E.must_fail(refused, good, r"missing")                      # checker: a good package is not refused
+finally:
+    shutil.rmtree(inrepo, ignore_errors=True)
+assert not inrepo.exists()
+
+# ---------------------------------------------------------------- manifest vs board and backup (unit)
+def manifest_refused(**change):
+    import re
+    pkg = dict(loaded, manifest=dict(loaded["manifest"], **{k: v for k, v in change.items() if k.isupper()}))
+    board_id = change.get("board", "ufi103s"); emmc = change.get("emmc", E.EMMC_SECTORS); layout = change.get("layout", E.LAYOUT_ID)
+    try:
+        easy._check_fw_manifest(pkg, board_id, emmc, layout)
+    except easy.EasyError as exc:
+        assert "Nothing was written" in str(exc)
+        return
+    raise AssertionError("manifest accepted: %s" % change)
+easy._check_fw_manifest(loaded, "ufi103s", E.EMMC_SECTORS, E.LAYOUT_ID)
+for change in ({"BOARD": "mf800b"}, {"board": "mf800b"}, {"EMMC_SECTORS": "7634945"}, {"emmc": 7634945}, {"LAYOUT_ID": "other-layout"}, {"layout": "other"}):
+    manifest_refused(**change)
+real_manifest = easy._check_fw_manifest
+easy._check_fw_manifest = lambda *a: None
+E.must_fail(manifest_refused, BOARD="mf800b")
+easy._check_fw_manifest = real_manifest
+
+# ---------------------------------------------------------------- tz..tzbak range with WRITTEN_NAMES extended (unit)
+assert set(easy.FW_PHASE_ORDER) <= set(easy.WRITTEN_NAMES) and set(easy.PAYLOAD_NAMES) <= set(easy.WRITTEN_NAMES)
+assert easy.ABSORBED_NAMES == {"tzbak": "tz"} and easy.STOCK_FIRMWARE_LBA["tzbak"] == easy.STOCK_FIRMWARE_LBA["tz"] + 1024
+with board.initial.open("rb") as disk:
+    backup_rows = easy._planned_rows(disk.read(34 * SEC))
+set_dir = board.make_image_set("unit")
+good_planned = easy._planned_rows((set_dir / "layout/gpt-T-primary.bin").read_bytes())
+easy._check_firmware_unchanged(backup_rows, good_planned)
+assert good_planned["tz"] == (270336, 272383) and "tzbak" not in good_planned
+
+
+def tz_refused(planned):
+    try:
+        easy._check_firmware_unchanged(backup_rows, planned)
+    except easy.EasyError as exc:
+        assert "Nothing was written" in str(exc)
+        return
+    raise AssertionError("a planned GPT with tz %s tzbak=%s was accepted" % (planned.get("tz"), "tzbak" in planned))
+
+
+bad = [dict(good_planned, tz=(270336, 271359)),                       # tz stays 1024, tzbak removed
+       dict(good_planned, tz=(270336, 272383 - 512)),                 # short of the end of tzbak
+       dict(good_planned, tz=(270336, 272383 + 512)),                 # beyond the end of tzbak
+       dict(good_planned, tz=(270337, 272383)),                       # moved
+       dict(good_planned, tzbak=(271360, 272383)),                    # tzbak kept
+       dict(good_planned, sbl1=(262145, 263168)),                     # written firmware may not move either
+       {k: v for k, v in good_planned.items() if k != "tz"}]
+for planned in bad:
+    tz_refused(planned)
+real_tz = easy._check_tz_range
+easy._check_tz_range = lambda backup_rows, planned: None              # mutation: the tz..tzbak range check is broken
+E.must_fail(tz_refused, bad[0]); E.must_fail(tz_refused, bad[1]); E.must_fail(tz_refused, bad[2]); E.must_fail(tz_refused, bad[3])
+tz_refused(bad[5])                                                    # the generic rule still stops a moved sbl1 (independent guard)
+easy._check_tz_range = real_tz
+E.must_fail(tz_refused, good_planned)                                 # checker: the good plan is not refused
+
+# ---------------------------------------------------------------- lk2nd composite (unit)
+lk_path = board.lk2nd
+os.environ["LK2ND_IMG"] = str(lk_path)
+easy.LK2ND_PADDED_SHA256 = E.sha256_hex(lk_path.read_bytes())
+small = board.base / "small-boot.img"
+small.write_bytes(E.synthetic_boot_image())
+composite = easy._build_composite(root, small, 32768)
+assert composite[:0x80000] == E.synthetic_lk2nd() and composite[0x80000:] == small.read_bytes() and len(composite) == 0x80000 + small.stat().st_size
+
+
+def composite_refused(boot=small, cap=32768, pattern=r"Nothing was written"):
+    import re
+    try:
+        easy._build_composite(root, boot, cap)
+    except easy.EasyError as exc:
+        assert re.search(pattern, str(exc)), str(exc)
+        return
+    raise AssertionError("composite accepted")
+
+
+exact = board.base / "exact-boot.img"; exact.write_bytes(E.synthetic_boot_image_sized(32768 * SEC - 0x80000))
+over = board.base / "over-boot.img"; over.write_bytes(E.synthetic_boot_image_sized(32768 * SEC - 0x80000 + 2048))
+assert len(easy._build_composite(root, exact, 32768)) == 32768 * SEC            # boundary control
+composite_refused(over, 32768, r"does not fit the boot partition")
+odd = board.base / "odd-boot.img"; odd.write_bytes(small.read_bytes() + b"x"); composite_refused(odd, 32768, r"whole number of sectors")
+os.environ["LK2ND_IMG"] = str(board.base / "nope.img"); composite_refused(pattern=r"missing lk2nd image")
+wrong_size = board.base / "lk-short.img"; wrong_size.write_bytes(E.synthetic_lk2nd()[:-512]); os.environ["LK2ND_IMG"] = str(wrong_size)
+composite_refused(pattern=r"exactly 524288")
+wrong_pin = board.base / "lk-wrong.img"; wrong_pin.write_bytes(b"\1" + E.synthetic_lk2nd()[1:]); os.environ["LK2ND_IMG"] = str(wrong_pin)
+composite_refused(pattern=r"does not match the pin")
+os.environ["LK2ND_IMG"] = str(lk_path)
+real_fit = easy._check_composite_fits
+easy._check_composite_fits = lambda total, capacity: None
+E.must_fail(composite_refused, over, 32768, r"does not fit")
+easy._check_composite_fits = real_fit
+real_pin = easy.LK2ND_PADDED_SHA256
+easy.LK2ND_PADDED_SHA256 = E.sha256_hex(wrong_pin.read_bytes())
+os.environ["LK2ND_IMG"] = str(wrong_pin)
+E.must_fail(composite_refused, pattern=r"does not match the pin")
+easy.LK2ND_PADDED_SHA256 = real_pin
+os.environ["LK2ND_IMG"] = str(lk_path)
+
+# ---------------------------------------------------------------- end to end: every one stops with 'Nothing was written'
+IMAGE = board.make_image_set("e2e")
+BASE = [E.FLAG_IMAGE_SET, str(IMAGE), E.FLAG_YES]
+
+
+def e2e(extra=None, pkg=None, env=None, rules=None, fw_pkg=True):
+    board.reset_disk()
+    board.plug()
+    args = list(BASE) + (extra or [])
+    if pkg is not None:
+        args += ["--fw-pkg", str(pkg)]
+    return board.easy(args, rules or E.base_rules(board, yes=True), env_overrides=env or {}, fw_pkg=fw_pkg and pkg is None)
+
+
+# reference: the good package flashes (so each refusal below is about its own cause)
+rc0, out0 = e2e()
+assert rc0 == 0 and board.writes(), out0[-1500:]
+
+rc, out = e2e(fw_pkg=False)
+E.check_refused(board, rc, out, r"no firmware package: pass --fw-pkg DIR")
+rc, out = e2e(pkg=cases["altered"][0])
+E.check_refused(board, rc, out, r"fw/aboot\.img does not match SHA256SUMS")
+rc, out = e2e(pkg=cases["missing"][0])
+E.check_refused(board, rc, out, r"fw/rpm\.img is missing")
+rc, out = e2e(pkg=link)
+E.check_refused(board, rc, out, r"must not be a symlink")
+inrepo2 = pathlib.Path(root) / (".fwpkg-test-e2e-%d" % os.getpid())
+try:
+    shutil.copytree(good, inrepo2)
+    rc, out = e2e(pkg=inrepo2)
+    E.check_refused(board, rc, out, r"OUTSIDE the repo")
+    rc_m, out_m = e2e(pkg=inrepo2, env={"OPENSTICK_TEST_MUTATE": "no-pkg-dir-check"})
+    E.must_fail(E.check_refused, board, rc_m, out_m, r"OUTSIDE the repo")
+    assert board.writes(), "pkg-dir mutation: the run did not write, so it proves nothing"
