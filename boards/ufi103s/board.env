# Board: UFI103S (HW1.3, PCB UFI103S_V02), 512 MB RAM.
# Values use ${VAR:-default} so config/local.env or the environment can override them.
BOARD_DESC="UFI103S 4G stick (thwc,ufi103s)"
# Step 1 (first image): DTB from the pmOS kernel apk (boot/dtbs/qcom/, 6.6-r5), NOT compiled by us.
# Step 2: custom msm8916-thwc-ufi103s.dtb (compiled by scripts/build-dtb.sh), select with
#   DTB_NAME=msm8916-thwc-ufi103s.dtb
DTB_NAME=${DTB_NAME:-msm8916-thwc-ufi001c.dtb}
# lk2nd board compatible, from lk2nd/device/dts/msm8916/msm8916-512mb-mtp.dts (thwc-ufi001c node).
LK2ND_COMPATIBLE=${LK2ND_COMPATIBLE:-thwc,ufi001c}
# eMMC size in 512-byte sectors: 3909091328 bytes / 512 = 7634944, from backup of board #6.
# TO CONFIRM against the GPT in the backup before any flash.
EMMC_SECTORS=${EMMC_SECTORS:-7634944}
SECTOR_SIZE=512
# GPT template (local dump of THIS board's primary GPT, 34 sectors). Set it in config/local.env (git-ignored), not here:
#   BOARD_GPT_TEMPLATE=/path/to/gpt-primary.bin
