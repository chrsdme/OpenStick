+i=0; MAXPOLLS=$((WAIT_SECS*4)); NOROOT=no
+case "$(cat $CMDLINE_FILE)" in *testboot.noroot*) NOROOT=yes; MAXPOLLS=0; log "rootfs: testboot.noroot on the cmdline, stage skipped";; esac
