# Default build configuration. Do NOT put personal values or secrets here.
# Override any variable in config/local.env (git-ignored) or in the environment.
# sudo here does NOT pass the environment (sudo -E is ignored). Set values in config/local.env,
# boards/<BOARD>/board.env, or: sudo env VAR=val ./scripts/20-rootfs.sh

# --- Distribution -----------------------------------------------------------
RELEASE=bookworm
MIRROR=http://deb.debian.org/debian
COMPONENTS=main

# --- Board / boot -----------------------------------------------------------
# Board specific values (DTB, lk2nd compatible, eMMC size) live in boards/<BOARD>/board.env.
BOARD=ufi103s
BOOT_MODE=mainline
# Unique GUIDs of the NEW boot/rootfs partitions (embedded in extlinux/fstab; checked against the GPT by tests/verify-images.sh)
ROOT_PARTUUID=a7ab80e8-e9d1-e8cd-f157-93f69b1d141e
BOOT_PARTUUID=80780b1d-0fe1-27d3-23e4-9244e62f8c46
# rootfs.img (ext4) identity: fstab mounts root by label; the UUID is passed to mkfs (-U) for reproducible images
ROOT_LABEL=osroot
ROOT_FS_UUID=5a1c0de0-7e57-4b00-8000-0f1e5c0de005
# USB gadget (configs/gadget.conf.in -> /etc/openstick/gadget.conf): ecm | ecm+acm | rndis. A ttyGS0 login exists only for PROFILE=dev with acm.
GADGET_MODE=ecm

# --- Kernel (postmarketOS msm8916 package, as in the original Builder) ------
KERNEL_APK_URL=http://mirror.postmarketos.org/postmarketos/v24.06/aarch64/linux-postmarketos-qcom-msm8916-6.6-r5.apk
KERNEL_APK_SHA256=8166387eaca9189ff923e635857afb272886b433925a1a7a172d4ed2bab4baa9

# --- System -----------------------------------------------------------------
HOST_NAME=openstick-debian
TIMEZONE=Etc/UTC
# anything but C.UTF-8 adds the locales package
LOCALE=C.UTF-8

# --- Profile ----------------------------------------------------------------
# dev  = test account, empty root password, serial autologin (ttyMSM0, ttyGS0), motd "DEV IMAGE"; openstick-harden installed.
# prod = no default credentials: the build REFUSES unless SSH_PUBKEY_FILE (valid public key) or ROOT_PASSWORD_HASH is set.
#        root locked (unless a hash is given), no autologin, no getty on ttyGS0, sshd key-only when a key is the only credential.
PROFILE=dev
# optional crypt hash for root ($y$, $6$ or $5$ prefix; e.g. mkpasswd -m yescrypt). Put it in config/user.env, never here.
ROOT_PASSWORD_HASH=

# --- Users ------------------------------------------------------------------
# Default user (PROFILE=dev only; in prod it is created only when set to a name other than "openstick": key-only, locked password, no sudo).
# Created at build time. The default password is publicly
# documented: it is marked expired so the first login forces a change.
DEFAULT_USER=openstick
DEFAULT_PASS=openstick
# 0 = do not expire the default password
FORCE_PASSWD_CHANGE=1
# optional: file with public keys appended to authorized_keys
SSH_PUBKEY_FILE=
# root keeps an empty password (serial console / ADB). sshd refuses it
# (PermitEmptyPasswords no, PermitRootLogin prohibit-password).

# --- Network ----------------------------------------------------------------
HOTSPOT_SSID=OpenStick
# empty = hotspot profile NOT installed (8..63 chars)
HOTSPOT_PSK=
LTE_APN=internet

# --- Packages ---------------------------------------------------------------
# Installed in the base tarball (stage 1):
BASE_PACKAGES="systemd-sysv udev kmod iproute2"
# Installed in the rootfs (stage 2), --no-install-recommends:
ROOTFS_PACKAGES="network-manager dnsmasq-base nftables modemmanager rmtfs qrtr-tools wpasupplicant wireless-regdb openssh-server e2fsprogs systemd-timesyncd tzdata libconfig9"
# dev profile only (added by setup.sh; removed in prod): sudo
# your additions, e.g. "wireguard-tools"
EXTRA_PACKAGES=""

# --- Headless services ------------------------------------------------------
# Units masked in the image (stick on mobile data: no apt/e2scrub/db-backup timers, no wait-online). systemd-timesyncd stays.
# Override in config/user.env; an empty value masks nothing; remove a name to keep that unit.
DISABLE_UNITS="apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer e2scrub_all.timer e2scrub_reap.service NetworkManager-wait-online.service"

# --- SSH exposure -----------------------------------------------------------
# Firewall: input policy drop; SSH only on usb0/wlan0. SSH over cellular (wwan*) is always blocked in the image; enable on the device: openstick-ssh-cellular on
