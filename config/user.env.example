# Copy to config/user.env (git-ignored) or to any path in OPENSTICK_USER_CONFIG, then chmod 600.
# Plain KEY=value shell syntax. Never commit the real file.
SSH_PUBKEY_FILE=/home/you/.ssh/id_ed25519.pub   # public key(s) for root and the default user
WIFI_SSID=
WIFI_PSK=                                       # 8..63 chars; both empty = no client WiFi profile
LTE_APN=internet
# --- production profile (see config/defaults.env) ---
# PROFILE=prod                    # needs SSH_PUBKEY_FILE (above) and/or ROOT_PASSWORD_HASH
# ROOT_PASSWORD_HASH='$y$...'     # crypt hash ($y$, $6$, $5$); single quotes, the value contains $
# --- headless units masked by default (see config/defaults.env); drop a name to keep that unit ---
# DISABLE_UNITS="apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer e2scrub_all.timer e2scrub_reap.service NetworkManager-wait-online.service"
